<?xml version="1.0" encoding="utf-8"?>
<!-- EXPERIMENTAL. The Talk page, in the layout language of Columba's talk screen:
     a banner, state first; one button to open Columba's talk when it is off; a
     column per key with its selector position, channel, room, floor and last
     result; and the two keys side by side, filling the rest. Every control is
     labelled; focus runs banner, open button, card A, card B, key A, key B. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF121212"
    android:splitMotionEvents="true">

    <LinearLayout
        android:id="@+id/talk_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:focusable="true"
        android:background="#FF1E3A4C">

        <TextView
            android:id="@+id/talk_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/pane_empty" />

        <TextView
            android:id="@+id/talk_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/talk_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFB000"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <Button
        android:id="@+id/talk_open_columba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:minHeight="64dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:text="@string/talk_open_columba"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/talk_card_a"
            layout="@layout/talk_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp" />

        <include
            android:id="@+id/talk_card_b"
            layout="@layout/talk_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="150dp"
        android:padding="8dp"
        android:orientation="horizontal"
        android:splitMotionEvents="true">

        <include
            android:id="@+id/talk_key_a"
            layout="@layout/talk_key"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp" />

        <include
            android:id="@+id/talk_key_b"
            layout="@layout/talk_key"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
